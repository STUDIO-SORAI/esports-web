---
import type { Brief } from '../lib/types'
import { formatFeedTime } from '../lib/api'
import { categoryPath } from '../lib/config'
import { toPlainShareTitle } from '../lib/seo'
import { briefBodyToText } from '../lib/briefBody'
import { BriefMedia } from './BriefMedia'
import { BriefBody } from './BriefBody'

interface Props {
  briefs: Brief[]
  heading?: string
  showMore?: boolean
  emptyText?: string
  compactHeader?: boolean
}

const {
  briefs,
  heading = '電競快訊',
  showMore = false,
  emptyText,
  compactHeader = false,
} = Astro.props
---

{
  (briefs.length > 0 || emptyText) && (
    <section class="flex flex-col" aria-labelledby="briefs-heading">
      {
        !compactHeader && (
          <div class="flex items-center justify-between px-1 pb-3">
            <h2
              id="briefs-heading"
              class="text-lg font-bold text-[var(--foreground)] tracking-tight"
            >
              {heading}
            </h2>
            {
              showMore && (
                <a
                  href="/feed"
                  class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors"
                >
                  看更多 &rarr;
                </a>
              )
            }
          </div>
        )
      }
      {compactHeader && <h2 id="briefs-heading" class="sr-only">{heading}</h2>}

      {
        briefs.length === 0 && emptyText ? (
          <p class="text-sm text-[var(--text-muted)] py-16 text-center">{emptyText}</p>
        ) : (
          <div class="flex flex-col space-y-4">
            {briefs.map((brief, i) => {
              const title = toPlainShareTitle(brief.title)
              const authorName = brief.authorNames[0] || 'SORAI'
              const authorImage = brief.authorImages[0] || ''
              const initial = authorName.charAt(0)
              const summary = briefBodyToText(brief.body)
              const body = summary && summary.trim() !== title.trim() ? brief.body : ''
              return (
                <article
                  id={`brief-${brief.slug}`}
                  class="arc-reveal flex gap-3 px-1 py-4 scroll-mt-24"
                  style={`--stagger: ${i % 8};`}
                >
                  <div class="shrink-0 pt-0.5">
                    {
                      authorImage ? (
                        <img
                          src={authorImage}
                          alt=""
                          class="w-10 h-10 rounded-full object-cover bg-[var(--surface-muted)] "
                        />
                      ) : (
                        <div class="w-10 h-10 text-sm rounded-full bg-[var(--surface-muted)] text-[var(--foreground)]  flex items-center justify-center font-bold">
                          {initial}
                        </div>
                      )
                    }
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2 min-w-0">
                      <span class="font-bold text-[15px] text-[var(--foreground)] truncate">
                        {authorName}
                      </span>
                      <time
                        datetime={brief.publishedAt}
                        class="shrink-0 text-xs text-[var(--text-muted)] tabular-nums font-normal"
                      >
                        {formatFeedTime(brief.publishedAt || brief.updatedAt)}
                      </time>
                      {
                        brief.category && brief.categorySlug && (
                          <a
                            href={categoryPath(brief.categorySlug)}
                            class="shrink-0 text-xs text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors truncate font-normal"
                          >
                            {brief.category}
                          </a>
                        )
                      }
                    </div>
                    <h3 class="mt-1 text-[15px] font-bold text-[var(--foreground)] leading-snug tracking-tight">
    <a href={`/brief/${brief.slug}`} class="hover:text-[var(--accent)] transition-colors">{title}</a>
  </h3>
                    {body && <BriefBody client:visible body={body} compact />}
                    {
                      brief.image && (
                        <div class="mt-3 rounded-[var(--radius-panel)] overflow-hidden  bg-[var(--surface-muted)] w-fit max-w-full [&>astro-island]:contents">
                          <BriefMedia
                            client:visible
                            src={brief.image}
                            alt={title}
                            mime={brief.imageMime}
                            width={brief.imageWidth}
                            height={brief.imageHeight}
                            className="max-h-[520px] max-w-full w-auto h-auto object-contain"
                          />
                        </div>
                      )
                    }
                  </div>
                </article>
              )
            })}
          </div>
        )
      }
    </section>
  )
}
