---
import Base from '../layouts/Base.astro'
import MobileMatchBar from '../components/MobileMatchBar'
import TournamentSidebar, { MatchSidebar } from '../components/TournamentSidebar'
import LiquidMetalButton from '../components/LiquidMetalButton'
import { GoogleSourceCard } from '../components/GoogleSourceCard'
import { GoogleSwg } from '../components/GoogleSwg'
import { fetchAllTournamentEvents, fetchAllMatches } from '../lib/pandascore'
import {
  fetchPosts,
  fetchPost,
  fetchBriefs,
  parseMaybeJsonArray,
  formatDate,
  formatFeedTime,
  getReadTime,
  hasTourRosterTag,
  fetchNavCategories,
} from '../lib/api'
import { CATEGORY_FALLBACK, categoryPath, topicPath } from '../lib/config'
import { buildTopicIndex } from '../lib/topics'
import { postsInCategory } from '../lib/categorySections'
import { splitShareTitleLines, toPlainShareTitle } from '../lib/seo'
import { briefBodyToText } from '../lib/briefBody'

// 快訊短文裡單獨成行的網址會在內頁變成嵌入，首頁卡片只留文字
const briefCardBody = (b: any) => {
  const summary = briefBodyToText(b.body)
  return summary && summary.trim() !== String(b.title).trim() ? summary : ''
}

const cmsNavCategories = await fetchNavCategories().catch(() => [])
const navCategories =
  cmsNavCategories.length > 0
    ? cmsNavCategories.map(({ name, slug }) => ({ name, slug }))
    : [...CATEGORY_FALLBACK]

// Fetch PandaScore matches & tournaments
const { upcoming: upcomingTournaments, running: runningTournaments, finished: finishedTournaments } =
  await fetchAllTournamentEvents()
const { upcoming: upcomingMatches, running: runningMatches, finished: finishedMatches } =
  await fetchAllMatches()

const posts = await fetchPosts()
const latestBriefs = await fetchBriefs(3).catch(() => [])
const visiblePosts = posts.filter((p: any) => !hasTourRosterTag(p))
const sortedPosts = [...visiblePosts].sort((a, b) => {
  const da = new Date(a.publishedAt || a.updatedAt || 0).getTime()
  const db = new Date(b.publishedAt || b.updatedAt || 0).getTime()
  return db - da
})

const heroPost = sortedPosts[0]
const heroTitleLines = heroPost ? splitShareTitleLines(heroPost.title) : []
const recentPostsBasic = sortedPosts.slice(1, 9)

const recentPosts = await Promise.all(
  recentPostsBasic.map(async (post) => {
    const full = await fetchPost(post.slug)
    return full || post
  })
)

// 右欄的主題索引。buildTopicIndex 會濾掉與主分類同名的標籤 —— 那些下方
// 已經有專屬 bento 區塊，再列一次等於同一個入口做兩次。
const topicIndex = buildTopicIndex(sortedPosts, navCategories)
const leadTopics = topicIndex.slice(0, 2)
const chipTopics = topicIndex.slice(2, 12)

/** 依文章數分三級字重字級，讓熱門主題在標籤雲裡自己浮出來。 */
const topicChipScale = (count: number) => {
  if (count >= 5) return 'text-sm font-black'
  if (count >= 3) return 'text-[13px] font-bold'
  return 'text-xs font-semibold'
}

const DEFAULT_IMAGE =
  'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiPjxyZWN0IHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIGZpbGw9IiMzMzMiLz48L3N2Zz4='

const getCategoryLogo = (cat: string) => {
  if (cat === '特戰英豪') return '/valorantct.png'
  if (cat === '英雄聯盟') return '/lolesports.png'
  if (cat === '虹彩六號') return '/rainbow6.png'
  if (cat === 'CS2') return '/cs2v2.webp'
  return null
}

const getSourceDisplay = (post: any) => {
  const tags = parseMaybeJsonArray(post.tags)
  if (tags.length > 0) return tags[0].toUpperCase()
  return 'SOURCES'
}

const HOME_BENTO_SLOTS = 3
const listedSlugs = new Set(
  [heroPost?.slug, ...recentPosts.slice(0, 5).map((post: any) => post.slug)].filter(Boolean),
)
const briefCards = latestBriefs.slice(0, 3).map((b: any) => ({
  kind: 'brief',
  href: '/brief/' + b.slug,
  title: b.title,
  body: briefCardBody(b),
  image: b.image || '',
  authorName: (b.authorNames && b.authorNames[0]) || 'SORAI',
  authorImage: (b.authorImages && b.authorImages[0]) || '',
  time: formatFeedTime(b.publishedAt || b.updatedAt),
}))
const newsCards = sortedPosts
  .filter((post: any) => !listedSlugs.has(post.slug))
  .slice(0, Math.max(0, HOME_BENTO_SLOTS - briefCards.length))
  .map((post: any) => {
    const authors = parseMaybeJsonArray(post.authors)
    return {
      kind: 'post',
      href: '/post/' + post.slug,
      title: post.title,
      body: post.description || '',
      image: post.coverImage || '',
      authorName: authors[0] || 'SORAI',
      authorImage: '',
      time: formatFeedTime(post.publishedAt || post.updatedAt),
    }
  })
const homeBento = [...briefCards, ...newsCards].slice(0, HOME_BENTO_SLOTS)
---

<Base title="SORAI ESPORTS｜中文電競新聞、賽事資訊與產業分析">
  <div
    class="w-full bg-[var(--bg)] dark:bg-[#111] text-[var(--ink)] dark:text-zinc-300 font-sans min-h-screen selection:bg-red-500/30 overflow-x-hidden pb-20 relative"
  >
    <!-- MOBILE MATCH BAR - static below navbar -->
    <div class="xl:hidden w-full bg-[var(--bg)] dark:bg-[#111] border-b border-[var(--line)] dark:border-zinc-800">
      <MobileMatchBar
        client:load
        upcoming={upcomingMatches}
        running={runningMatches}
        finished={finishedMatches}
      />
    </div>

    <!-- DESKTOP: sidebars + main content in sticky flex layout -->
    <div class="xl:flex xl:gap-6 xl:px-4">
      <!-- LEFT SIDEBAR -->
      <div class="hidden xl:block w-[200px] shrink-0 sticky top-4 self-start">
        <TournamentSidebar
          client:load
          upcoming={upcomingTournaments}
          running={runningTournaments}
          finished={finishedTournaments}
        />
      </div>

      <!-- MAIN CONTENT -->
      <div class="w-full xl:flex-1 flex flex-col gap-12 px-4 xl:px-0 pt-14 xl:pt-1">
        <h1 class="sr-only">SORAI ESPORTS 中文電競新聞</h1>
        <!-- HERO SECTION -->
        {
          heroPost && (
            <div class="relative w-full aspect-video md:aspect-[21/9] bg-gray-100 dark:bg-black group overflow-hidden border border-[var(--line)] dark:border-zinc-800 rounded-xl shadow-sm">
              <a href={'/post/' + heroPost.slug} class="block w-full h-full cursor-pointer">
                <img
                  src={heroPost.coverImage || DEFAULT_IMAGE}
                  class="w-full h-full object-cover opacity-90 dark:opacity-80 cover-zoom"
                  alt={toPlainShareTitle(heroPost.title)}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

                <div class="absolute bottom-0 left-0 w-full p-6 md:p-10 z-10">
                  <div class="flex items-center gap-2 mb-3 text-[10px] uppercase font-bold tracking-widest text-gray-300">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-zinc-400"
                    >
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                    </svg>
                    <span class="text-red-400 font-bold tracking-widest font-en">LATEST NEWS</span>
                  </div>
                  <h2
                    class="text-2xl sm:text-3xl md:text-5xl font-bold text-white group-hover:text-red-400 transition-colors uppercase tracking-tight leading-[1] font-en"
                  >
                    {heroTitleLines.map((line) => (
                      <span class="block">{line}</span>
                    ))}
                  </h2>
                  {heroPost.description && (
                    <p class="hidden md:block mt-4 text-gray-300 font-medium text-sm md:text-base max-w-2xl line-clamp-2">
                      {heroPost.description}
                    </p>
                  )}
                </div>
              </a>
            </div>
          )
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:items-stretch">
          <div class="lg:col-span-2 flex flex-col h-full min-w-0">
            <LiquidMetalButton
              client:load
              href="/matches"
              runningCount={runningMatches.length}
            />
                <div class="flex items-center gap-2 pb-4 border-b-2 border-[var(--ink)] dark:border-zinc-800 mb-6">
                  <svg
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-zinc-400"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <h2 class="text-xl md:text-2xl font-serif font-black text-[var(--ink)] dark:text-zinc-100 uppercase tracking-tight">
                    最新文章
                  </h2>
                </div>
                <div class="flex flex-col divide-y divide-[var(--line)] dark:divide-zinc-800">
                  {
                    recentPosts.slice(0, 5).map((post, i) => (
                      <a
                        href={'/post/' + post.slug}
                        class="flex group py-6 items-center gap-4 hover:opacity-80 transition-opacity"
                      >
                        <div class="w-32 md:w-48 aspect-video shrink-0 bg-[var(--surface-elevated)] dark:bg-zinc-900 rounded overflow-hidden shadow-sm border border-[var(--line)] dark:border-zinc-800">
                          <img
                            src={post.coverImage || DEFAULT_IMAGE}
                            class="w-full h-full object-cover cover-zoom"
                            alt={toPlainShareTitle(post.title)}
                          />
                        </div>
                        <div class="flex-1 flex flex-col justify-center min-w-0">
                          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-2 text-[10px] text-[var(--ink-soft)] dark:text-zinc-500 font-bold uppercase tracking-wider">
                            <span class={(i + 1) % 2 === 0 ? 'text-red-500' : 'text-cyan-600 dark:text-cyan-500'}>
                              [{getSourceDisplay(post)}]
                            </span>
                            <span class="hidden sm:inline opacity-50">|</span>
                            <div class="hidden sm:block">
                              {formatDate(post.publishedAt || post.updatedAt).replace(/-/g, '.')}
                            </div>
                            <span class="hidden sm:inline opacity-50">|</span>
                            <div class="hidden sm:block">{getReadTime(post)}</div>
                          </div>
                          <h3 class="text-base md:text-lg font-bold text-[var(--ink)] dark:text-zinc-200 group-hover:text-[var(--accent)] dark:group-hover:text-white line-clamp-2 md:line-clamp-3 leading-snug">
                            {toPlainShareTitle(post.title)}
                          </h3>
                          {post.description && (
                            <p class="hidden lg:block mt-2 text-xs text-[var(--ink-soft)] dark:text-zinc-500 line-clamp-2">
                              {post.description}
                            </p>
                          )}
                        </div>
                      </a>
                    ))
                  }
                </div>

            <div class="flex flex-col min-w-0 flex-1 mt-8">
            <div class="flex items-center justify-between pb-3 border-b border-[var(--line)] dark:border-zinc-800 mb-3">
              <div class="flex items-center gap-2">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-zinc-400"
                  aria-hidden="true"
                >
                  <path d="M4 11a9 9 0 0 1 9 9" />
                  <path d="M4 4a16 16 0 0 1 16 16" />
                  <circle cx="5" cy="19" r="1" />
                </svg>
                <h2 class="text-base md:text-lg font-serif font-black text-[var(--ink)] dark:text-zinc-100 tracking-tight">
                  電競快訊
                </h2>
              </div>
              <a
                href="/feed"
                class="text-[11px] font-bold text-zinc-500 hover:text-red-400 transition-colors shrink-0"
              >
                看更多
              </a>
            </div>
            <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-3 items-stretch">
                  {
                    homeBento.map((item) => (
                      <a
                        href={item.href}
                        class="group flex flex-col h-full rounded-2xl border border-[var(--line)] dark:border-zinc-800 bg-[var(--bg)] dark:bg-[#111] p-3 hover:bg-[var(--surface-elevated)] dark:hover:bg-zinc-900/80 transition-colors min-h-0"
                      >
                        <div class="flex items-center gap-2 min-w-0">
                          {
                            item.authorImage ? (
                              <img
                                src={item.authorImage}
                                alt=""
                                class="w-10 h-10 rounded-full object-cover bg-zinc-800 shrink-0"
                              />
                            ) : (
                              <div class="w-10 h-10 rounded-full bg-zinc-800 text-zinc-200 flex items-center justify-center text-sm font-bold shrink-0">
                                {item.authorName.charAt(0)}
                              </div>
                            )
                          }
                          <span class="font-semibold text-[15px] text-[var(--ink)] dark:text-zinc-100 truncate">
                            {item.authorName}
                          </span>
                          <span class="text-zinc-500 shrink-0">·</span>
                          <time class="text-[13px] text-zinc-500 shrink-0">{item.time}</time>
                        </div>
                        <p class="mt-2 text-[15px] text-[var(--ink)] dark:text-zinc-100 leading-snug line-clamp-3">
                          {toPlainShareTitle(item.title)}
                        </p>
                        {
                          item.body && (
                            <p class="mt-1 text-[14px] text-zinc-500 dark:text-zinc-400 leading-relaxed line-clamp-2">
                              {item.body}
                            </p>
                          )
                        }
                        {
                          item.image && (
                            <div class="mt-auto pt-3 w-full">
                              <div class="w-full rounded-2xl overflow-hidden border border-[var(--line)] dark:border-zinc-800 bg-zinc-900 aspect-video">
                                <img
                                  src={item.image}
                                  alt=""
                                  class="w-full h-full object-cover"
                                />
                              </div>
                            </div>
                          )
                        }
                      </a>
                    ))
                  }
            </div>
            </div>
          </div>

          <!-- 主題索引（1/3 欄）：一次列完全站話題標籤，主分類不在此重覆 -->
          <div class="lg:col-span-1 flex flex-col h-full min-w-0">
            <div class="flex items-center gap-2 pb-4 border-b-2 border-[var(--ink)] dark:border-zinc-800 mb-6">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-zinc-500"
              >
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
              </svg>
              <h2 class="text-xl md:text-2xl font-serif font-black text-[var(--ink)] dark:text-zinc-100 uppercase tracking-tight">
                主題分類
              </h2>
            </div>

            <div class="flex flex-col gap-6 flex-1 min-h-0">
              {
                leadTopics.map((topic) => (
                  <div class="flex flex-col">
                    <div class="flex items-center justify-between mb-3 border-b border-[var(--line)] dark:border-zinc-800 pb-2">
                      <h3 class="text-sm font-black uppercase text-[var(--ink)] dark:text-zinc-300 tracking-wider flex items-center gap-1.5">
                        <span class="text-[var(--accent)] dark:text-red-500">#</span>
                        <span>{topic.name}</span>
                      </h3>
                      <a
                        href={topicPath(topic.name, navCategories)}
                        class="text-[10px] uppercase font-bold text-[var(--ink-soft)] hover:text-[var(--accent)] transition-colors"
                      >
                        {topic.count} 篇 &rarr;
                      </a>
                    </div>
                    <a href={'/post/' + topic.latestPost.slug} class="group flex flex-col gap-3">
                      <div class="w-full aspect-video shrink-0 bg-[var(--surface-elevated)] dark:bg-zinc-900 rounded overflow-hidden shadow-sm border border-[var(--line)] dark:border-zinc-800">
                        <img
                          src={topic.latestPost.coverImage || DEFAULT_IMAGE}
                          class="w-full h-full object-cover cover-zoom"
                          alt={toPlainShareTitle(topic.latestPost.title)}
                        />
                      </div>
                      <h4 class="text-sm font-bold text-[var(--ink)] dark:text-zinc-200 group-hover:text-[var(--accent)] dark:group-hover:text-white leading-tight">
                        {toPlainShareTitle(topic.latestPost.title)}
                      </h4>
                      <div class="text-[10px] text-[var(--ink-soft)] dark:text-zinc-500 font-bold uppercase">
                        {formatDate(
                          topic.latestPost.publishedAt || topic.latestPost.updatedAt
                        ).replace(/-/g, '.')}
                      </div>
                    </a>
                  </div>
                ))
              }

              {
                chipTopics.length > 0 && (
                  <div class="flex flex-col">
                    <div class="mb-3 border-b border-[var(--line)] dark:border-zinc-800 pb-2">
                      <h3 class="text-sm font-black uppercase text-[var(--ink)] dark:text-zinc-300 tracking-wider">
                        熱門主題
                      </h3>
                    </div>
                    <ul class="flex flex-wrap gap-2">
                      {chipTopics.map((topic) => (
                        <li>
                          <a
                            href={topicPath(topic.name, navCategories)}
                            class={`group inline-flex items-baseline gap-1.5 rounded-full border border-[var(--line)] dark:border-zinc-800 bg-[var(--surface-elevated)] dark:bg-[#141416] px-3 py-1.5 text-[var(--ink)] dark:text-zinc-300 hover:border-[var(--ink)] dark:hover:border-zinc-500 hover:text-[var(--accent)] dark:hover:text-white transition-[color,border-color,background-color] ${topicChipScale(topic.count)}`}
                          >
                            <span class="text-[var(--ink-soft)] dark:text-zinc-600 group-hover:text-[var(--accent)] dark:group-hover:text-red-500">
                              #
                            </span>
                            <span>{topic.name}</span>
                            <span class="text-[10px] font-bold text-[var(--ink-soft)] dark:text-zinc-600 tabular-nums">
                              {topic.count}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }

              <a
                href="/tag"
                class="w-full py-4 text-center rounded border border-[var(--line)] dark:border-zinc-800 text-xs font-bold text-[var(--ink-soft)] hover:bg-[var(--surface-elevated)] dark:hover:bg-zinc-900 hover:text-[var(--ink)] dark:hover:text-white uppercase tracking-widest transition-colors"
              >
                探索更多主題
              </a>

              <div class="mt-auto">
                <GoogleSourceCard client:load />
              </div>
            </div>
          </div>
        </div>

        <!-- CATEGORY SECTIONS -->
        <div class="flex flex-col gap-16 mt-16">
          {
            navCategories.map(({ name: category, slug: categorySlug }) => {
              // 只看主要分類；標籤帶到同名分類不算（例如標了 #英雄聯盟 的其他遊戲文章）
              const categoryPosts = postsInCategory(sortedPosts, {
                name: category,
                slug: categorySlug,
              })
              if (categoryPosts.length === 0) return null

              const logoPath = getCategoryLogo(category)

              return (
                <div class="flex flex-col" id={category === '專欄報導' ? 'category-opinion' : undefined}>
                  {category === '專欄報導' && (
                    <GoogleSwg client:load targetSelector="#category-opinion" />
                  )}
                  {/* Section Header */}
                  <div class="flex items-center justify-between pb-4 border-b border-zinc-200 dark:border-zinc-800 mb-6">
                    <div class="flex items-center gap-3">
                      {logoPath ? (
                        <img
                          src={logoPath}
                          alt={category}
                          class="h-6 w-auto object-contain brightness-0 dark:invert opacity-60"
                        />
                      ) : (
                        <svg
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="text-zinc-500 dark:text-zinc-400"
                        >
                          <rect x="3" y="3" width="7" height="7" rx="1" />
                          <rect x="14" y="3" width="7" height="7" rx="1" />
                          <rect x="14" y="14" width="7" height="7" rx="1" />
                          <rect x="3" y="14" width="7" height="7" rx="1" />
                        </svg>
                      )}
                      <h2 class="text-xl md:text-2xl font-serif font-black text-[var(--ink)] dark:text-zinc-100 uppercase tracking-tight">
                        {category}
                      </h2>
                    </div>
                    <a
                      href={categoryPath(categorySlug)}
                      class="text-xs font-bold text-[var(--ink-soft)] dark:text-zinc-500 hover:text-red-500 dark:hover:text-red-400 transition-colors uppercase tracking-widest flex items-center gap-1"
                    >
                      查看全部 <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>

                  {/* Bento Cards Grid */}
                  <div class="grid grid-cols-1 md:grid-cols-4 auto-rows-[220px] md:auto-rows-[180px] lg:auto-rows-[220px] gap-4 mb-4">
                    {/* Large Post */}
                    {categoryPosts[0] && (
                      <a
                        href={'/post/' + categoryPosts[0].slug}
                        class="group relative rounded-xl md:col-span-2 md:row-span-2 overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-900 shadow-sm"
                      >
                        <img
                          src={categoryPosts[0].coverImage || DEFAULT_IMAGE}
                          class="absolute inset-0 w-full h-full object-cover opacity-90 cover-zoom"
                          alt={toPlainShareTitle(categoryPosts[0].title)}
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent" />
                        <div class="absolute bottom-0 left-0 p-5 md:p-6 w-full text-white">
                          <h3 class="text-xl md:text-2xl font-bold line-clamp-2 md:line-clamp-3 leading-snug group-hover:text-red-400 transition-colors drop-shadow-md">
                            {toPlainShareTitle(categoryPosts[0].title)}
                          </h3>
                          <div class="mt-3 flex items-center gap-2">
                            <div class="h-[2px] w-5 bg-red-500 rounded-full" />
                            <span class="text-[11px] text-zinc-200 font-bold uppercase tracking-widest">
                              {formatDate(
                                categoryPosts[0].publishedAt || categoryPosts[0].updatedAt
                              ).replace(/-/g, '.')}
                            </span>
                          </div>
                        </div>
                      </a>
                    )}

                    {/* Small Post 1 */}
                    {categoryPosts[1] && (
                      <a
                        href={'/post/' + categoryPosts[1].slug}
                        class="group relative rounded-xl md:col-span-1 md:row-span-1 overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-900 shadow-sm"
                      >
                        <img
                          src={categoryPosts[1].coverImage || DEFAULT_IMAGE}
                          class="absolute inset-0 w-full h-full object-cover opacity-80 cover-zoom"
                          alt={toPlainShareTitle(categoryPosts[1].title)}
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent" />
                        <div class="absolute bottom-0 left-0 p-4 w-full text-white">
                          <h3 class="text-[14px] md:text-[15px] font-bold line-clamp-3 leading-[1.4] group-hover:text-red-400 transition-colors drop-shadow-md">
                            {toPlainShareTitle(categoryPosts[1].title)}
                          </h3>
                        </div>
                      </a>
                    )}

                    {/* Small Post 2 */}
                    {categoryPosts[2] && (
                      <a
                        href={'/post/' + categoryPosts[2].slug}
                        class="group relative rounded-xl md:col-span-1 md:row-span-1 overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-900 shadow-sm"
                      >
                        <img
                          src={categoryPosts[2].coverImage || DEFAULT_IMAGE}
                          class="absolute inset-0 w-full h-full object-cover opacity-80 cover-zoom"
                          alt={toPlainShareTitle(categoryPosts[2].title)}
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent" />
                        <div class="absolute bottom-0 left-0 p-4 w-full text-white">
                          <h3 class="text-[14px] md:text-[15px] font-bold line-clamp-3 leading-[1.4] group-hover:text-red-400 transition-colors drop-shadow-md">
                            {toPlainShareTitle(categoryPosts[2].title)}
                          </h3>
                        </div>
                      </a>
                    )}

                    {/* Wide Post 3 */}
                    {categoryPosts[3] && (
                      <a
                        href={'/post/' + categoryPosts[3].slug}
                        class="group relative rounded-xl md:col-span-2 md:row-span-1 overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-900 shadow-sm"
                      >
                        <img
                          src={categoryPosts[3].coverImage || DEFAULT_IMAGE}
                          class="absolute inset-0 w-full h-full object-cover opacity-80 cover-zoom"
                          alt={toPlainShareTitle(categoryPosts[3].title)}
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent" />
                        <div class="absolute bottom-0 left-0 p-4 md:p-5 w-full text-white flex flex-col justify-end">
                          <h3 class="text-[15px] md:text-base font-bold line-clamp-2 md:line-clamp-1 leading-snug group-hover:text-red-400 transition-colors drop-shadow-md">
                            {toPlainShareTitle(categoryPosts[3].title)}
                          </h3>
                          <div class="mt-1.5 text-[10px] text-zinc-300 font-bold uppercase tracking-wider hidden sm:block">
                            {formatDate(
                              categoryPosts[3].publishedAt || categoryPosts[3].updatedAt
                            ).replace(/-/g, '.')}
                          </div>
                        </div>
                      </a>
                    )}
                  </div>
                </div>
              )
            })
          }
        </div>
      </div>

      <!-- RIGHT SIDEBAR -->
      <div class="hidden xl:block w-[200px] shrink-0 sticky top-4 self-start">
        <MatchSidebar
          client:load
          upcoming={upcomingMatches}
          running={runningMatches}
          finished={finishedMatches}
        />
      </div>
    </div>
  </div>
</Base>
