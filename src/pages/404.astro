---
import Base from '../layouts/Base.astro'
import { fetchPosts, formatDate, getReadTime } from '../lib/api'
import { toPlainShareTitle } from '../lib/seo'

Astro.response.status = 404

const posts = await fetchPosts().catch(() => [])
const recentPosts = posts.slice(0, 3)
---

<Base
  title="404 找不到頁面"
  description="很抱歉，您所尋找的頁面不存在、已被移動或尚未發佈。"
  noindex={true}
>
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 w-full py-12 sm:py-20 flex flex-col items-center">
    <!-- 404 Hero Visual -->
    <div class="relative flex flex-col items-center text-center max-w-2xl mx-auto">
      <div class="relative">
        <span class="font-serif font-black text-8xl sm:text-9xl tracking-tighter text-zinc-200 dark:text-zinc-800 select-none">
          404
        </span>
        <span class="absolute inset-0 flex items-center justify-center font-serif font-black text-4xl sm:text-5xl tracking-widest text-red-600 dark:text-red-500 uppercase">
          NOT FOUND
        </span>
      </div>

      <div class="mt-4 flex items-center gap-2 text-xs font-bold text-red-500 uppercase tracking-widest">
        <span>ERROR 404</span>
        <span>•</span>
        <span>戰術地圖未探索</span>
      </div>

      <h1 class="mt-3 font-serif text-2xl sm:text-3xl font-black text-zinc-900 dark:text-white">
        很抱歉，找不到您請求的頁面
      </h1>

      <p class="mt-3 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-lg leading-relaxed">
        您欲瀏覽的新聞報導可能已被移除、重新命名，或是網址輸入有誤。您可以返回首頁或探索下方最新的賽事快訊。
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="px-6 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-bold text-sm transition-colors shadow-lg shadow-red-600/20"
        >
          返回首頁
        </a>
        <a
          href="/submit"
          class="px-6 py-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-bold text-sm transition-colors border border-zinc-200 dark:border-zinc-700"
        >
          讀者專欄投稿
        </a>
      </div>
    </div>

    <!-- Recommended Posts Section -->
    {recentPosts.length > 0 && (
      <div class="mt-20 w-full pt-12 border-t border-zinc-200 dark:border-zinc-800">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-bold text-red-500 uppercase tracking-widest block mb-1">
              RECOMMENDED
            </span>
            <h2 class="font-serif text-xl sm:text-2xl font-black text-zinc-900 dark:text-white">
              最新電競賽事報導
            </h2>
          </div>
          <a
            href="/"
            class="text-xs font-bold text-zinc-500 hover:text-red-500 transition-colors uppercase tracking-wider"
          >
            查看更多 →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <a
              href={`/post/${post.slug}`}
              class="group flex flex-col bg-white dark:bg-[#18181b] border border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-zinc-300 dark:hover:border-zinc-700 transition-[box-shadow,border-color] duration-300"
            >
              <div class="w-full aspect-[16/9] overflow-hidden bg-zinc-900 relative">
                {post.coverImage ? (
                  <img
                    src={post.coverImage}
                    alt={toPlainShareTitle(post.title)}
                    class="w-full h-full object-cover cover-zoom"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-zinc-700 font-serif font-black text-xl">
                    SORAI
                  </div>
                )}
                {post.category && (
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[11px] font-bold bg-black/70 text-white backdrop-blur-md border border-white/10">
                    {post.category}
                  </span>
                )}
              </div>
              <div class="p-5 flex flex-col flex-1 justify-between">
                <h3 class="font-bold text-sm sm:text-base text-zinc-900 dark:text-white group-hover:text-red-500 dark:group-hover:text-red-400 transition-colors line-clamp-2 leading-snug">
                  {toPlainShareTitle(post.title)}
                </h3>
                <div class="mt-4 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
                  <span>{formatDate(post.publishedAt)}</span>
                  <span>{getReadTime(post.content || '')}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Base>
