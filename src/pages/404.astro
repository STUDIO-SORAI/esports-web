---
import { getCategoryLogo } from '../lib/config'
import Base from '../layouts/Base.astro'
import { fetchPosts, formatDate, getReadTime } from '../lib/api'
import { toPlainShareTitle } from '../lib/seo'
import { Badge } from '../components/arc/badge/badge'
import { InViewTitle } from '../components/arc/in-view-title/in-view-title'

Astro.response.status = 404

const posts = await fetchPosts().catch(() => [])
const recentPosts = posts.slice(0, 3)
---

<Base
  title="404 找不到頁面"
  description="很抱歉，您所尋找的頁面不存在、已被移動或尚未發佈。"
  noindex={true}
>
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 w-full py-12 sm:py-20 flex flex-col items-center font-sans">
    <div class="arc-entrance relative flex flex-col items-center text-center max-w-2xl mx-auto" style="--stagger: 0;">
      <div class="relative mb-4">
        <span class="font-bold text-8xl sm:text-9xl tracking-tighter text-[var(--border)] select-none">
          404
        </span>
      </div>

      <h1 class="mt-2 text-2xl sm:text-3xl font-bold text-[var(--foreground)] tracking-tight">
        很抱歉，找不到您請求的頁面
      </h1>

      <p class="mt-3 text-sm sm:text-base text-[var(--text-secondary)] max-w-lg leading-relaxed font-normal">
        您欲瀏覽的新聞報導可能已被移除、重新命名，或是網址輸入有誤。您可以返回首頁或探索下方最新的賽事快訊。
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="px-5 py-2.5 rounded-[var(--radius-control)] bg-[var(--accent)] hover:opacity-90 text-[var(--accent-foreground)] font-semibold text-sm transition-opacity shadow-xs"
        >
          返回首頁
        </a>
        <a
          href="/submit"
          class="px-5 py-2.5 rounded-[var(--radius-control)] bg-[var(--surface)] hover:bg-[var(--surface-muted)] text-[var(--foreground)] font-semibold text-sm transition-colors  "
        >
          讀者專欄投稿
        </a>
      </div>
    </div>

    {recentPosts.length > 0 && (
      <div class="mt-20 w-full pt-10">
        <div class="flex items-baseline justify-between mb-8">
          <InViewTitle
            client:visible
            text="最新電競賽事報導"
            variant="blur"
            className="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--foreground)]"
          />
          <a
            href="/"
            class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors"
          >
            查看更多 &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentPosts.map((post, i) => (
            <a
              href={`/post/${post.slug}`}
              class="arc-reveal group flex flex-col bg-[var(--surface)]  hover:bg-[var(--surface-muted)]  rounded-[var(--radius-panel)] overflow-hidden shadow-xs hover:shadow-md hover:-translate-y-1 active:scale-[0.99] transition-[transform,box-shadow,background-color] duration-200"
              style={`--stagger: ${i};`}
            >
              <div class="w-full aspect-[16/9] overflow-hidden bg-[var(--surface-muted)] relative">
                {post.coverImage ? (
                  <img
                    src={post.coverImage}
                    alt={toPlainShareTitle(post.title)}
                    class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-[var(--text-muted)] font-bold text-xl">
                    SORAI
                  </div>
                )}
                {post.category && (
                  <div class="absolute top-3 left-3">
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide text-white drop-shadow-md">
                      {getCategoryLogo(post.category) && (
                        <img
                          src={getCategoryLogo(post.category)!}
                          alt=""
                          class="w-3.5 h-3.5 object-contain shrink-0"
                        />
                      )}
                      <span>#{post.category}</span>
                    </span>
                  </div>
                )}
              </div>
              <div class="p-5 flex flex-col flex-1 justify-between gap-4">
                <h3 class="font-bold text-sm sm:text-base text-[var(--foreground)] group-hover:text-[var(--accent)] transition-colors line-clamp-2 leading-snug tracking-tight">
                  {toPlainShareTitle(post.title)}
                </h3>
                <div class="flex items-center justify-between text-xs text-[var(--text-muted)] font-normal  pt-3">
                  <span>{formatDate(post.publishedAt)}</span>
                  <span>{getReadTime(post)}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Base>
