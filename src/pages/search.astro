---
import Base from '../layouts/Base.astro'
import { fetchPosts, fetchAuthors, parseMaybeJsonArray } from '../lib/api'
import { HorizontalCard } from '../components/Cards'
import { InViewTitle } from '../components/arc/in-view-title/in-view-title'

const query = Astro.url.searchParams.get('q') || ''
const posts = await fetchPosts()

const allAuthorIds = [...new Set(posts.flatMap((p) => parseMaybeJsonArray(p.authors)))]
const authorsList = await fetchAuthors(allAuthorIds)
const authorsMap = new Map(authorsList.map((a) => [a.id, a]))

const lowerQuery = query.toLowerCase()

const filteredPosts = posts
  .filter((post) => {
    return (
      (post.title || '').toLowerCase().includes(lowerQuery) ||
      (post.description || '').toLowerCase().includes(lowerQuery) ||
      (post.content || '').toLowerCase().includes(lowerQuery)
    )
  })
  .sort((a, b) => {
    const da = new Date(a.publishedAt || a.updatedAt || 0).getTime()
    const db = new Date(b.publishedAt || b.updatedAt || 0).getTime()
    return db - da
  })
---

<Base title="搜尋" noindex={true}>
  <div class="max-w-[1240px] mx-auto px-4 md:px-6 xl:px-8 pt-10 min-h-[60vh] font-sans">
    <div class="mb-8 flex items-baseline gap-4">
      <InViewTitle
        client:visible
        text="搜尋結果"
        variant="blur"
        className="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[var(--foreground)]"
      />
      {query && <span class="text-xl text-[var(--text-secondary)] font-normal">"{query}"</span>}
    </div>

    {
      !query ? (
        <div class="text-center py-20 text-[var(--text-secondary)] font-normal">
          請在上方的搜尋框輸入關鍵字開始搜尋。
        </div>
      ) : filteredPosts.length === 0 ? (
        <div class="text-center py-20 text-[var(--text-secondary)] rounded-[var(--radius-panel)]  bg-[var(--surface-muted)] p-12">
          <p class="text-xl font-bold text-[var(--foreground)] mb-2">找不到相關文章</p>
          <p class="text-sm text-[var(--text-secondary)] font-normal">很抱歉，沒有找到與 "{query}" 相關的文章，請嘗試使用其他關鍵字。</p>
        </div>
      ) : (
        <div class="flex flex-col gap-6 max-w-4xl mx-auto">
          <p class="text-[var(--text-secondary)] text-sm mb-4 font-normal">共找到 {filteredPosts.length} 篇文章</p>
          {filteredPosts.map((post, i) => (
            <div class="arc-reveal" style={`--stagger: ${i};`}>
              <HorizontalCard client:load post={post} authorsMap={authorsMap} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</Base>
