---
import { SiteNavbar } from '../components/SiteNavbar'
import { CookieConsent } from '../components/CookieConsent'
import { GoogleSourceBanner } from '../components/GoogleSourceBanner'
import { fetchPosts, fetchNavCategories } from '../lib/api'
import { CATEGORY_FALLBACK } from '../lib/config'
import {
  SITE_NAME,
  DEFAULT_DESCRIPTION,
  absoluteUrl,
  siteOrigin,
  organizationJsonLd,
  websiteJsonLd,
  toPlainShareTitle,
} from '../lib/seo'
import '../components/arc/foundation.css'
import '../app/globals.css'
import 'skullet/styles.css'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: string
  canonical?: string
  noindex?: boolean
  publishedTime?: string
  modifiedTime?: string
  jsonLd?: object | object[]
}

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  image = '/og-image.png',
  type = 'website',
  canonical,
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props

const origin = siteOrigin(Astro.request, Astro.url)
const canonicalUrl = canonical || `${origin}${Astro.url.pathname}`
const absImage = absoluteUrl(origin, image)
const posts = await fetchPosts().catch(() => [])
const cmsCategories = await fetchNavCategories().catch(() => [])
// CMS 掛掉時仍要有導覽列可用，不然整站看起來像壞了。
const navItems = cmsCategories.length > 0
  ? cmsCategories.map(({ name, slug }) => ({ name, slug }))
  : [...CATEGORY_FALLBACK]

const latestPostsByCategory: Record<
  string,
  { slug: string; title: string; coverImage?: string }[]
> = {}

for (const cat of navItems) {
  const matching = posts.filter((p: any) => {
    if (p.categorySlug) return p.categorySlug === cat.slug
    const pCat = (p.category || '').trim().toLowerCase()
    const targetCat = cat.name.trim().toLowerCase()
    return pCat === targetCat
  })
  latestPostsByCategory[cat.name] = matching
    .sort(
      (a: any, b: any) =>
        new Date(b.publishedAt || b.updatedAt || 0).getTime() -
        new Date(a.publishedAt || a.updatedAt || 0).getTime()
    )
    .slice(0, 3)
    .map((p: any) => ({
      slug: p.slug,
      title: p.title,
      coverImage: p.coverImage,
    }))
}

const displayTitle = toPlainShareTitle(title)
const fullTitle =
  !displayTitle || displayTitle === SITE_NAME
    ? `${SITE_NAME}｜中文電競新聞、賽事資訊與產業分析`
    : displayTitle.includes(SITE_NAME)
      ? displayTitle
      : `${SITE_NAME} - ${displayTitle}`
const shareTitle =
  type === 'article' && displayTitle && displayTitle !== SITE_NAME
    ? displayTitle
    : fullTitle
const currentYear = new Date().getFullYear()
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [organizationJsonLd(origin), websiteJsonLd(origin), ...extraJsonLd],
}
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        const theme = stored ? stored : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS Feed`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} 電競快訊`} href="/rss-briefs.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-256x256.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" type="image/png" href="/_w.png" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <link
      rel="preload"
      href="/LINE%20Seed%20TW_ver02/WOFF2/LINESeedTW_OTF_Rg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/LINE%20Seed%20TW_ver02/WOFF2/LINESeedTW_OTF_Bd.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=boska@400,500,700,900&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- First-party pageview tracker (CMS dashboard). No third-party analytics. -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return
        try {
          var sidKey = '_sorai_sid'
          var sid = sessionStorage.getItem(sidKey)
          if (!sid) {
            sid = 's_' + Math.random().toString(36).slice(2, 11) + Date.now().toString(36)
            sessionStorage.setItem(sidKey, sid)
          }

          var startTime = Date.now()
          var url = '/api/analytics'

          function sendHit(duration) {
            var timezone = ''
            try {
              timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''
            } catch (e) {}
            var data = {
              session: sid,
              path: window.location.pathname || '/',
              referrer: document.referrer || '',
              title: document.title || '',
              duration: duration || 0,
              timezone: timezone,
            }
            if (navigator.sendBeacon) {
              navigator.sendBeacon(
                url,
                new Blob([JSON.stringify(data)], { type: 'application/json' })
              )
            } else {
              fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
                keepalive: true,
              }).catch(function () {})
            }
          }

          sendHit(0)

          window.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') {
              var dur = Math.round((Date.now() - startTime) / 1000)
              if (dur > 0 && dur < 1800) {
                sendHit(dur)
              }
            }
          })
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans antialiased selection:bg-[var(--accent-subtle)]">
    <div class="w-full min-h-screen flex flex-col">
      <a class="skip-link" href="#main-content">跳至主要內容</a>
      <SiteNavbar client:load navItems={navItems} latestPostsByCategory={latestPostsByCategory} />
      <main id="main-content" tabindex="-1" class="pb-24 pt-28 flex-1">
        <slot />
      </main>

      <footer class="w-full border-t border-[var(--surface-muted)] bg-[var(--surface)] text-[var(--foreground)] pt-14 pb-10 relative overflow-hidden flex-shrink-0 mt-auto">
        <div class="max-w-[1240px] mx-auto px-6 w-full relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-[var(--surface-muted)]">
            <!-- Brand & Info (Left) -->
            <div class="md:col-span-6 flex flex-col items-start gap-3.5">
              <a href="/" class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] rounded transition-opacity duration-150 hover:opacity-85">
                <img
                  src="/logotype-og_w.png"
                  alt="SORAI ESPORTS"
                  class="h-7 md:h-8 w-auto invert dark:invert-0 opacity-90"
                />
              </a>
              <p class="text-[var(--text-secondary)] text-xs sm:text-sm font-normal leading-relaxed max-w-md">
                提供最新、最深度的中文圈電競新聞，
                <br class="hidden sm:inline" />
                涵蓋賽事第一手資訊、戰隊動態與產業深度觀點。
              </p>
              <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--surface-muted)] text-[11px] font-medium text-[var(--text-muted)]">
                <span>Powered by STUDIO SORAI</span>
              </div>
            </div>

            <!-- Navigation Links (Right) -->
            <div class="md:col-span-6 grid grid-cols-2 gap-8 md:justify-end">
              <!-- Content -->
              <div class="flex flex-col gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--foreground)]">
                  站內內容
                </span>
                <ul class="flex flex-col gap-2.5 text-xs sm:text-sm">
                  <li>
                    <a href="/matches" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      賽事資訊
                    </a>
                  </li>
                  <li>
                    <a href="/transfers" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      轉會名單 (VCT)
                    </a>
                  </li>
                  <li>
                    <a href="/feed" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      即時快訊
                    </a>
                  </li>
                  <li>
                    <a href="/submit" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      讀者投稿
                    </a>
                  </li>
                </ul>
              </div>

              <!-- About & Terms -->
              <div class="flex flex-col gap-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--foreground)]">
                  關於與條款
                </span>
                <ul class="flex flex-col gap-2.5 text-xs sm:text-sm">
                  <li>
                    <a href="/about" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      關於我們
                    </a>
                  </li>
                  <li>
                    <a href="/sponsor" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      贊助我們
                    </a>
                  </li>
                  <li>
                    <a href="/contact" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      聯絡我們
                    </a>
                  </li>
                  <li>
                    <a href="/privacy" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      隱私權政策
                    </a>
                  </li>
                  <li>
                    <a href="/disclaimer" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-150">
                      內容聲明
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Bottom Sub-Bar -->
          <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
            <p class="font-sans text-[11px] sm:text-xs tracking-wider uppercase font-medium">
              &copy; {currentYear} SORAI ESPORTS. ALL RIGHTS RESERVED.
            </p>

            <button
              type="button"
              onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[var(--radius-control)] bg-[var(--surface-muted)] hover:bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--foreground)] text-xs font-medium transition-[background-color,color] duration-150 cursor-pointer group"
              aria-label="返回頁面頂部"
            >
              <span>返回頂部</span>
              <svg
                class="w-3.5 h-3.5 transition-transform duration-150 group-hover:-translate-y-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="18 15 12 9 6 15" />
              </svg>
            </button>
          </div>
        </div>
      </footer>
    </div>
    <CookieConsent client:load />
    <GoogleSourceBanner client:load />

    <script is:inline>
      document.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('#theme-toggle-btn') : null;
        if (btn) {
          const isDark = document.documentElement.classList.toggle('dark');
          const next = isDark ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (err) {}
          window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: next } }));
        }
      });

      function setupArcReveal() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.arc-reveal').forEach((el) => el.classList.add('arc-revealed'));
          return;
        }
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.arc-reveal').forEach((el) => el.classList.add('arc-revealed'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('arc-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });

        document.querySelectorAll('.arc-reveal:not(.arc-revealed)').forEach((el) => {
          observer.observe(el);
        });
      }

      function setupSkulletImages() {
        document.querySelectorAll('img.skullet-img').forEach((img) => {
          if (img.complete && img.naturalWidth > 0) {
            img.dataset.loaded = 'true';
          } else {
            img.addEventListener('load', () => {
              img.dataset.loaded = 'true';
            }, { once: true });
          }
        });
      }

      setupArcReveal();
      setupSkulletImages();
      document.addEventListener('astro:page-load', () => {
        setupArcReveal();
        setupSkulletImages();
      });
      document.addEventListener('DOMContentLoaded', () => {
        setupArcReveal();
        setupSkulletImages();
      });
    </script>
  </body>
</html>
