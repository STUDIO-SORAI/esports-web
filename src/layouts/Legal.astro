---
import Base from './Base.astro'
import { InViewTitle } from '../components/arc/in-view-title/in-view-title'

interface Props {
  title: string
  description: string
  updated?: string
}

const { title, description, updated } = Astro.props
---

<Base title={title} description={description}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 w-full pt-8 pb-20 font-sans">
    <header class="mb-10 arc-entrance" style="--stagger: 0;">
      <InViewTitle
        client:visible
        text={title}
        variant="blur"
        className="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[var(--foreground)]"
      />
      {
        updated && (
          <p class="mt-3 text-xs text-[var(--text-muted)] font-normal">最後更新：{updated}</p>
        )
      }
      <p class="mt-4 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed font-normal">
        {description}
      </p>
    </header>
    <div class="arc-entrance text-sm sm:text-base text-[var(--foreground)] leading-relaxed space-y-8 [&_h2]:text-xl [&_h2]:sm:text-2xl [&_h2]:font-bold [&_h2]:text-[var(--foreground)] [&_h2]:mb-3 [&_h2]:tracking-tight [&_p]:mb-3 [&_p]:text-[var(--text-secondary)] [&_p]:font-normal [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_ul]:text-[var(--text-secondary)] [&_a]:underline [&_a]:underline-offset-2 [&_a]:text-[var(--accent)] [&_a]:hover:opacity-80" style="--stagger: 1;">
      <slot />
    </div>
  </div>
</Base>
