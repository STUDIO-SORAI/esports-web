---
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  updated?: string
}

const { title, description, updated } = Astro.props
---

<Base title={title} description={description}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 w-full pt-8 pb-20">
    <header class="mb-10 pb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div class="text-xs text-red-500 font-bold uppercase tracking-widest mb-2">
        SORAI ESPORTS
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-black text-zinc-900 dark:text-white">
        {title}
      </h1>
      {
        updated && (
          <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400">最後更新：{updated}</p>
        )
      }
      <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {description}
      </p>
    </header>
    <div class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed space-y-8 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:font-black [&_h2]:text-zinc-900 dark:[&_h2]:text-white [&_h2]:mb-3 [&_p]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_a]:underline [&_a]:underline-offset-2 [&_a]:hover:text-red-500">
      <slot />
    </div>
  </div>
</Base>
