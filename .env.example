# ========================================================
# SORAI ESPORTS Frontend (apps/web) Environment Variables
# ========================================================

# 1. 網站基礎網址 (建議設定)
# 前端網站公開網址（結尾不帶斜線）
WEB_URL=http://localhost:4321

# 2. 後端 Payload CMS 連線網址
# 指向 Payload CMS 3 後台 API 位址
PAYLOAD_API_URL=http://localhost:3000

# 3. PandaScore API (選填)
# 用於首頁電競即時比分與近期賽程 (VALORANT, LoL, CS2 等)
# 申請網址: https://pandascore.co/
PANDASCORE_TOKEN=

# 4. 人機驗證簽章密鑰 (Captcha / 防機器人投稿)
# 用於驗證讀者專欄投稿時的 9 宮格選手圖形驗證簽章
# 請在生產環境設定一組足夠長且隨機的密鑰字串
CAPTCHA_SECRET=please-change-to-a-secure-random-secret-for-captcha

# 5. 網站資訊與聯絡設定 (選填)
NEWS_TITLE="SORAI Esports"
CONTACT_EMAIL=contact@example.com

# 6. 投稿離線資料庫 (選填，若啟用本機 SQLite / Turso)
# TURSO_DATABASE_URL=file:submissions.db
# TURSO_AUTH_TOKEN=
